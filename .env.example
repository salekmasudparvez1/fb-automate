# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for persistent storage
DATABASE_URL=

# ADMIN_EMAIL: Authorized administrator email allowed to sign in
ADMIN_EMAIL=

# ADMIN_PASSWORD: Administrator password for dashboard sign-in
ADMIN_PASSWORD=

# FACEBOOK_PAGE_ID: Your target Facebook Page ID (set via Secrets / env)
FACEBOOK_PAGE_ID=

# FACEBOOK_ACCESS_TOKEN: Long-lived Facebook Page Access Token with pages_manage_posts scope
FACEBOOK_ACCESS_TOKEN=

# Optional: Enable automatic exchange of short-lived User Tokens into never-expiring Page Tokens
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional: Secret bearer token required for unattended GET/POST /api/cron/scheduler runs on Vercel
CRON_SECRET=

# Cloudinary media uploads (Images & Videos for scheduled Facebook posts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth Policy & Security Configuration (set JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, COOKIE_SECRET in platform Secrets)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_MAX_AGE=604800000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=3
CORS_ORIGIN=
